{
  "name": "dsh-lol-esports",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "League of Legends Worlds viewing assistant for the DSH web UI — local fork with an in-game live stats strip.",
  "license": "MIT",
  "author": "Neil (local fork of Rustyibe/dsh-lol)",
  "forkedFrom": "https://github.com/Rustyibe/dsh-lol",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NeilNy/dsh-lol-esports.git"
  },
  "homepage": "https://github.com/NeilNy/dsh-lol-esports#readme",
  "bugs": {
    "url": "https://github.com/NeilNy/dsh-lol-esports/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "league-of-legends",
    "esports",
    "worlds"
  ],
  "devDependencies": {
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --format=iife --target=es2022 --jsx-factory=h --legal-comments=none --outfile=client.js",
    "check": "tsc --noEmit",
    "pretest": "npm run build && esbuild src/api.ts src/format.ts --bundle --format=esm --outdir=.tmp --log-level=warning",
    "test": "node --test"
  }
}
